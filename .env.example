# Copy this file to .env and fill in the values.

# Telegram bot token from @BotFather (/newbot). Required.
TELEGRAM_BOT_TOKEN=

# Anthropic API key for generating proposal drafts. Required for the "Черновик" button.
ANTHROPIC_API_KEY=

# Where to post. For a forum supergroup with topics:
#   TELEGRAM_CHAT_ID  = the supergroup id (looks like -1001234567890)
#   TELEGRAM_TOPIC_ID = the topic (thread) id to post into
# Tip: add the bot to the group, send /start INSIDE the target topic, and it will
# reply with both ids — copy them here. (If left empty, the bot uses whatever /start
# last captured.)
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=
